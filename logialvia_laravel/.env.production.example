# LogiALVIA : modele de .env de PRODUCTION (docs/logialvia/GUIDE_DEPLOIEMENT.md §5).
#
#   cp .env.production.example .env        # SUR LE SERVEUR, jamais dans le depot
#   php artisan key:generate --force
#   php artisan migrate --force && php artisan db:seed --force   # premier administrateur
#
# Ce fichier est un MODELE : aucune valeur reelle ici. Le vrai `.env` (et `.env.production`)
# est ignore par git. Ne commitez jamais de mot de passe, de cle ou de jeton.

APP_NAME=LogiALVIA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://logialvia.digitonpro.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base MySQL creee dans cPanel. Laisser DB_TIMEZONE par defaut (+00:00).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions, cache et file : sur la base (aucun Redis ni file a traiter).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie reserve a HTTPS : a laisser a true une fois le certificat actif.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mail sortant : SMTP du domaine (port 587, STARTTLS). Mot de passe : a saisir sur le serveur.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.logialvia.digitonpro.com
MAIL_PORT=587
MAIL_USERNAME=contact@logialvia.digitonpro.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@logialvia.digitonpro.com"
MAIL_FROM_NAME="${APP_NAME}"
# Destinataire du support de l'editeur.
SUPPORT_MAIL=rarhodes06@gmail.com

VITE_APP_NAME="${APP_NAME}"

# Premier administrateur (db:seed). 10 caracteres minimum, a changer a la premiere connexion.
# Renseigner pour le premier `db:seed`, puis RETIRER cette ligne du .env.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Exploitation : laisser a false (la remise a zero est reservee aux essais).
REMISE_A_ZERO_ACTIVEE=false
# Un poste est facultatif pour les operations a effet de stock (true = obligatoire).
STOCK_CIBLE_OBLIGATOIRE=false
# Duree de vie du jeton d'appairage d'un poste, en jours.
SANCTUM_EXPIRATION_JOURS=90
# Synchronisation : ne pas modifier sans raison.
SYNC_LIGNES_PAR_PAGE=200
SYNC_RECOUVREMENT_SECONDES=2
